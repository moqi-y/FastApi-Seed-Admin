# Application
APP_NAME=FastAPI-Admin
APP_VERSION=1.0.0
APP_DESCRIPTION=Reusable FastAPI admin backend
APP_HOST=127.0.0.1
APP_PORT=8080
APP_DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database: sqlite or mysql
SQL_TYPE=sqlite
SQLITE_FILE=FastApi-Seed-Admin.db
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=fastapi_admin

# Security - replace in every deployment
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=120
USE_CAPTCHA=false
