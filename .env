APP_NAME=FastAPI-Seed-Admin
APP_VERSION=1.0.0
APP_DESCRIPTION=可复用的 FastAPI 后台管理框架
APP_HOST=127.0.0.1
APP_PORT=8080
APP_DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 初始化项目默认使用 SQLite；需要 MySQL 时改为 mysql 并补全下方配置。
SQL_TYPE=sqlite
SQLITE_FILE=FastApi-Seed-Admin.db
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=fastapi_seed_admin

JWT_SECRET_KEY=please-replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=120
USE_CAPTCHA=false
