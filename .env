# 项目配置
APP_NAME="FastApi-Seed-Admin"
APP_VERSION="1.0.0"
APP_DESCRIPTION="基于FastApi的后台管理系统"
APP_HOST=127.0.0.1
APP_PORT=8080
# True 开发环境，False 生产环境,生产环境下不生成swagger接口文档
APP_DEBUG=True

#数据库选型配置
SQL_TYPE="mysql"  # 填写 mysql 或 sqlite

# mysql数据库配置,仅当SQL_TYPE=mysql时生效
MYSQL_HOST="192.168.1.59"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="admin@123"
MYSQL_DB="FastApi-Seed-Admin"

# sqlite数据库文件,仅当SQL_TYPE=sqlite时生效
SQLITE_FILE="FastApi-Seed-Admin.db"

# jwt加密密钥
JWT_SECRET_KEY="97GMawtJXe"
# jwt过期时间，单位：分钟
JWT_EXPIRE_MINUTES=120

# 是否使用图片验证码,True 开启，False 关闭
USE_CAPTCHA=False

# 邮箱配置，仅当使用发送邮件功能时配置
